#!/usr/bin/env bash
# olive-mail — Himalaya with local app-password file. Not secret.
# Bots call: olive-mail envelope list   (never himalaya)
set -euo pipefail

set_paths() {
  local cfg=${XDG_CONFIG_HOME:-$HOME/.config}
  OLIVE_MAIL_DIR=$cfg/olive-mail
  HIMALAYA_CONFIG=$OLIVE_MAIL_DIR/config.toml
}

# Absolute path of this script, symlinks resolved.
script_self() {
  local src=$0
  if [[ "$src" != /* ]]; then
    if [[ "$src" == */* ]]; then
      src=$PWD/$src
    else
      src=$(command -v "$src" || true)
      [[ -n "$src" ]] || src=$PWD/${0#./}
    fi
  fi
  while [[ -L "$src" ]]; do
    local dir link
    dir=$(cd -P "$(dirname "$src")" && pwd)
    link=$(readlink "$src")
    if [[ "$link" == /* ]]; then
      src=$link
    else
      src=$dir/$link
    fi
  done
  echo "$(cd -P "$(dirname "$src")" && pwd)/$(basename "$src")"
}

# Login rc we always update (create if missing). Darwin zsh reads .zprofile, not .profile.
login_rc() {
  case "$(uname -s)" in
    Darwin) echo "$HOME/.zprofile" ;;
    *) echo "$HOME/.profile" ;;
  esac
}

ensure_local_bin_in_path_files() {
  local snippet f login
  snippet='
# olive-mail: user bin
if [ -d "$HOME/.local/bin" ]; then
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
  esac
fi'
  login=$(login_rc)
  for f in "$login" "$HOME/.profile" "$HOME/.bash_profile" "$HOME/.bashrc" "$HOME/.zprofile" "$HOME/.zshrc"; do
    if [[ "$f" != "$login" && ! -f "$f" ]]; then
      continue
    fi
    if [[ -f "$f" ]] && grep -q 'olive-mail: user bin' "$f"; then
      continue
    fi
    printf '%s\n' "$snippet" >> "$f"
  done
}

# Symlink into ~/.local/bin (and /usr/local/bin if writable). Never add the repo to PATH.
ensure_on_path() {
  local self dest
  self=$(script_self)
  dest=$HOME/.local/bin/olive-mail
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$self" "$dest"
  if [[ -w /usr/local/bin ]]; then
    ln -sfn "$self" /usr/local/bin/olive-mail
  fi
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
  esac
  ensure_local_bin_in_path_files
}

brew_shellenv() {
  local b
  for b in \
    ${HOMEBREW_PREFIX:+"$HOMEBREW_PREFIX"/bin/brew} \
    /home/linuxbrew/.linuxbrew/bin/brew \
    /opt/homebrew/bin/brew \
    /usr/local/bin/brew
  do
    if [[ -x "$b" ]]; then
      eval "$("$b" shellenv)"
      return 0
    fi
  done
  command -v brew >/dev/null
}

ensure_brew() {
  if brew_shellenv; then
    return
  fi
  echo 'olive-mail: Homebrew missing; installing' >&2
  NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  if ! brew_shellenv; then
    echo 'olive-mail: Homebrew still not found after install' >&2
    exit 1
  fi
}

ensure_himalaya() {
  ensure_brew
  if command -v himalaya >/dev/null; then
    return
  fi
  echo 'olive-mail: himalaya missing; brew install himalaya' >&2
  brew install himalaya
  if ! command -v himalaya >/dev/null; then
    echo 'olive-mail: himalaya still not on PATH after brew install' >&2
    exit 1
  fi
}

olive_mail_auth() {
  local email="" imap_server="" pass pass2
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -h|--help)
        echo "usage: olive-mail auth [email] [--imap URL]" >&2
        echo "  Writes ~/.config/olive-mail/<email>.pass (mode 0600) and config.toml." >&2
        exit 0
        ;;
      --imap)
        if [[ -z "${2:-}" ]]; then
          echo 'olive-mail auth: --imap needs a URL (e.g. imaps://imap.example.com:993)' >&2
          exit 1
        fi
        imap_server=$2
        shift 2
        ;;
      -*)
        echo "olive-mail auth: unknown option $1" >&2
        exit 1
        ;;
      *)
        if [[ -n "$email" ]]; then
          echo 'olive-mail auth: unexpected extra argument' >&2
          exit 1
        fi
        email=$1
        shift
        ;;
    esac
  done

  if [[ -z "$email" ]]; then
    if [[ -t 0 ]]; then
      read -r -p "Email: " email
    else
      echo 'olive-mail auth: email required' >&2
      exit 1
    fi
  fi
  if [[ -z "$email" ]]; then
    echo 'olive-mail auth: empty email' >&2
    exit 1
  fi

  if [[ -z "$imap_server" ]]; then
    if [[ -t 0 ]]; then
      read -r -p "IMAP server (e.g. imaps://imap.example.com:993): " imap_server
    else
      echo 'olive-mail auth: --imap required when not a tty' >&2
      exit 1
    fi
  fi
  if [[ -z "$imap_server" ]]; then
    echo 'olive-mail auth: empty IMAP server' >&2
    exit 1
  fi

  set_paths
  local pass_file=$OLIVE_MAIL_DIR/${email}.pass

  if [[ -t 0 ]]; then
    echo "Mailbox: $email" >&2
    echo "IMAP:    $imap_server" >&2
    echo "Secret:  $pass_file" >&2
    read -rs -p "App password: " pass
    echo >&2
    read -rs -p "Again: " pass2
    echo >&2
    if [[ "$pass" != "$pass2" ]]; then
      echo 'olive-mail auth: passwords did not match' >&2
      exit 1
    fi
  else
    pass=$(cat)
  fi
  if [[ -z "${pass:-}" ]]; then
    echo 'olive-mail auth: empty password' >&2
    exit 1
  fi

  mkdir -p "$OLIVE_MAIL_DIR"
  umask 077
  printf '%s' "$pass" > "$pass_file"
  chmod 600 "$pass_file"
  unset pass pass2

  cat > "$HIMALAYA_CONFIG" <<EOF
# Generated by olive-mail auth. Password is not in this file.

[accounts."${email}"]
default = true
email = "${email}"
mailbox.alias.inbox = "INBOX"

imap.server = "${imap_server}"
imap.sasl.plain.username = "${email}"
imap.sasl.plain.passwd.command = ["/bin/cat", "${pass_file}"]

# No smtp block: bots must not send.
EOF

  echo "olive-mail auth: stored $email → $pass_file" >&2
  echo "olive-mail auth: Himalaya config → $HIMALAYA_CONFIG" >&2
}

ensure_himalaya
ensure_on_path

if [[ "${1:-}" == auth ]]; then
  shift
  olive_mail_auth "$@"
  exit 0
fi

set_paths
HIMALAYA=$(command -v himalaya)

# Soft send gate. Bots with a shell can still bypass via raw himalaya + this password.
deny_send() {
  local a=${1:-} b=${2:-}
  if [[ "$a" == smtp ]] || [[ "$a" == message && "$b" == send ]]; then
    echo 'olive-mail: send is disabled (no SMTP; drafts only)' >&2
    exit 1
  fi
  local arg
  for arg in "$@"; do
    if [[ "$arg" == --send ]]; then
      echo 'olive-mail: send is disabled (no SMTP; drafts only)' >&2
      exit 1
    fi
  done
}
deny_send "$@"

if [[ ! -f "$HIMALAYA_CONFIG" ]]; then
  echo "olive-mail: no config at $HIMALAYA_CONFIG. Run: olive-mail auth" >&2
  exit 1
fi
pass_ok=0
for f in "$OLIVE_MAIL_DIR"/*.pass; do
  if [[ -r "$f" ]]; then
    pass_ok=1
    break
  fi
done
if [[ "$pass_ok" -eq 0 ]]; then
  echo "olive-mail: no app password in $OLIVE_MAIL_DIR. Run: olive-mail auth" >&2
  exit 1
fi

exec "$HIMALAYA" -c "$HIMALAYA_CONFIG" "$@"
