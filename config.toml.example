# Written by olive-mail account add to ~/.config/olive-mail/config.toml.
# No password in this file. passwd.command cats ~/.config/olive-mail/<email>.pass

[accounts."you@example.com"]
default = true
email = "you@example.com"

imap.server = "imaps://imap.example.com:993"
imap.sasl.plain.username = "you@example.com"
# Absolute path; `olive-mail account add` writes the real ~/.config/olive-mail/<email>.pass
imap.sasl.plain.passwd.command = ["/bin/cat", "/path/to/.config/olive-mail/you@example.com.pass"]

# No smtp block: bots must not send.
